{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "esnext.disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Node runs src/*.ts directly (built-in type stripping) — tsc only type-checks.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Only syntax Node can strip: no enums, namespaces or constructor parameter properties.
    "erasableSyntaxOnly": true,
    // Type-only imports must say `import type` — Node erases them; a plain import of a type would fail at runtime.
    "verbatimModuleSyntax": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
