# syntax=docker/dockerfile:latest

# NODE_VERSION / ALPINE_VERSION / NODE_STOCK_DIGEST / COREPACK_VERSION build-args —
# REQUIRED, no defaults. The values come from versions.env (mise exports it; compose
# passes them through). The build fails loudly if one is unset. The base is pinned by
# digest: the tag documents the version, the digest is what is pulled.
ARG NODE_VERSION
ARG ALPINE_VERSION
ARG NODE_STOCK_DIGEST
ARG NODE_IMAGE=node:${NODE_VERSION:?"NODE_VERSION build-arg is required"}-alpine${ALPINE_VERSION:?"ALPINE_VERSION build-arg is required"}@${NODE_STOCK_DIGEST:?"NODE_STOCK_DIGEST build-arg is required"}

# Use official Node image
FROM ${NODE_IMAGE}

# Set development environment
ENV NODE_ENV=development
ARG COREPACK_VERSION

# Install development tools (useful for debugging) and create non-root user for security (even in dev)
RUN apk add --no-cache \
  git \
  bash && \
  addgroup -g 1001 -S nodejs && \
  adduser -S nodejs -u 1001

WORKDIR /app

# Copy package files first for better caching
COPY --chown=nodejs:nodejs package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Change ownership of the working directory, then install + enable corepack as root
# (both need write access to /usr/local). Node 25+ no longer bundles Corepack, so
# install COREPACK_VERSION from versions.env (npm is still bundled).
RUN chown nodejs:nodejs /app && \
  npm install --global --no-audit --no-fund "corepack@${COREPACK_VERSION:?COREPACK_VERSION build-arg is required}" && \
  corepack enable

# Switch to non-root user
USER nodejs

# Install package manager and dependencies
RUN PACKAGE_MANAGER=$(node -p "require('./package.json').packageManager") && \
  corepack install && \
  echo "=========================================================" && \
  echo "  Node version:                 $(node --version)" && \
  echo "  Package manager:              ${PACKAGE_MANAGER}" && \
  echo "=========================================================" && \
  pnpm install --config.scripts-prepend-node-path=true

# Copy the rest of the application
COPY --chown=nodejs:nodejs . .

# Expose port if your dev server uses one (adjust as needed)
# EXPOSE 3000

# Run development server
CMD ["pnpm", "dev"]