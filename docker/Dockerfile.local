# syntax=docker/dockerfile:latest

# Node + Alpine build-args — REQUIRED, no defaults. Compose passes them; mise exports
# both from the root package.json (NODE_VERSION from engines.node, ALPINE_VERSION from
# alpineVersion). Build fails loudly if either is unset.
ARG NODE_VERSION
ARG ALPINE_VERSION
ARG NODE_IMAGE=node:${NODE_VERSION:?"NODE_VERSION build-arg is required"}-alpine${ALPINE_VERSION:?"ALPINE_VERSION build-arg is required"}

# Use official Node image
FROM ${NODE_IMAGE}

# Set development environment
ENV NODE_ENV=development

# Install development tools (useful for debugging) and create non-root user for security (even in dev)
RUN apk add --no-cache \
  git \
  bash && \
  addgroup -g 1001 -S nodejs && \
  adduser -S nodejs -u 1001

WORKDIR /app

# Change ownership of the working directory and enable corepack as root
# (corepack enable needs write access to /usr/local/bin)
RUN chown nodejs:nodejs /app && \
  corepack enable

# Switch to non-root user
USER nodejs

# Copy package files first for better caching
COPY --chown=nodejs:nodejs package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install package manager and dependencies
RUN PACKAGE_MANAGER=$(node -p "require('./package.json').packageManager") && \
  corepack install && \
  echo "=========================================================" && \
  echo "  Node version:                 $(node --version)" && \
  echo "  Package manager:              ${PACKAGE_MANAGER}" && \
  echo "=========================================================" && \
  pnpm install --config.scripts-prepend-node-path=true

# Copy the rest of the application
COPY --chown=nodejs:nodejs . .

# Expose port if your dev server uses one (adjust as needed)
# EXPOSE 3000

# Run development server
CMD ["pnpm", "dev"]