{
  "name": "electrolux-to-mqtt",
  "version": "development",
  "description": "TypeScript bridge from the Electrolux appliance API to MQTT, with Home Assistant auto-discovery.",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "pnpm biome check --write",
    "clean": "rimraf node_modules",
    "dev:docker": "docker compose -f docker/docker-compose.local.yml down && docker compose -f docker/docker-compose.local.yml up --build",
    "backend:docker": "docker compose -f telemetry-backend/docker-compose.yml down && docker compose -f telemetry-backend/docker-compose.yml up --build",
    "dev": "tsx watch --conditions=development src/index.ts",
    "format": "pnpm biome format --write",
    "lint": "pnpm biome lint --write",
    "nuke": "pnpm clean ; pnpm install",
    "postinstall": "{ [ -f /.dockerenv ] || [ -n \"$CI\" ] || [ -n \"$DOCKER_BUILD\" ]; } && exit 0; bash .githooks/postinstall.sh || exit 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --coverage",
    "test:e2e": "E2E_TEST=true vitest run tests/e2e/*.test.ts",
    "test:watch": "vitest",
    "sonar": "sh scripts/sonar.sh",
    "osv-scan": "sh scripts/osv-scan.sh",
    "docker:test": "bash scripts/docker-build-test.sh",
    "deps:check": "pnpm outdated ; pnpm audit ; pnpm osv-scan",
    "deps:update": "pnpm update --latest && pnpm sync:versions && pnpm install",
    "sops:decrypt": "scripts/sops-env.sh decrypt",
    "sops:encrypt": "scripts/sops-env.sh encrypt",
    "sops:rotate": "scripts/sops-rotate.sh",
    "sops:sync-ci": "scripts/sync-ci-age-key.sh",
    "gitlab:rotate-pat": "scripts/rotate-gitlab-pat.sh",
    "sync:versions": "bash scripts/sync-versions.sh"
  },
  "keywords": [
    "electrolux",
    "home-assistant",
    "homeassistant",
    "mqtt",
    "iot",
    "smart-home"
  ],
  "author": "Kimmo Saari <kirbo@kirbo-designs.com>",
  "license": "MIT",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "alpineVersion": "3.24",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "dependencies": {
    "axios": "^1.20.0",
    "mqtt": "^5.16.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tiny-lru": "^13.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.4",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
