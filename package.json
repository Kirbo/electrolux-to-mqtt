{
  "name": "electrolux-to-mqtt",
  "version": "development",
  "description": "TypeScript bridge from the Electrolux appliance API to MQTT, with Home Assistant auto-discovery.",
  "private": true,
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "check": "pnpm biome check --write",
    "clean": "rimraf node_modules",
    "dev:docker": "docker compose -f docker/docker-compose.local.yml down && docker compose -f docker/docker-compose.local.yml up --build",
    "backend:docker": "docker compose -f telemetry-backend/docker-compose.yml down && sh scripts/backend-up.sh",
    "dev": "node --watch src/index.ts",
    "format": "pnpm biome format --write",
    "lint": "pnpm biome lint --write",
    "nuke": "pnpm clean ; pnpm install",
    "postinstall": "{ [ -f /.dockerenv ] || [ -n \"$CI\" ] || [ -n \"$DOCKER_BUILD\" ]; } && exit 0; bash .githooks/postinstall.sh || exit 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --coverage",
    "test:e2e": "E2E_TEST=true vitest run tests/e2e/*.test.ts",
    "test:watch": "vitest",
    "sonar": "fnox exec --no-defaults -P sonar -- sh scripts/sonar.sh",
    "osv-scan": "sh scripts/osv-scan.sh",
    "docker:test": "bash scripts/docker-build-test.sh",
    "deps:check": "pnpm outdated ; pnpm audit ; pnpm osv-scan",
    "deps:update": "pnpm update --latest && pnpm sync:versions && pnpm install",
    "secrets:setup": "bash scripts/secrets-setup.sh",
    "secrets:check": "fnox check --no-defaults -P read,publish,deploy,telemetry,sonar,renovate",
    "secrets:set": "sh scripts/secrets-set.sh",
    "secrets:env": "sh scripts/secrets-env.sh",
    "secrets:rotate-ci": "bash scripts/secrets-rotate-ci.sh",
    "gitlab:rotate-pat": "scripts/rotate-gitlab-pat.sh",
    "sync:versions": "bash scripts/sync-versions.sh"
  },
  "keywords": [
    "electrolux",
    "home-assistant",
    "homeassistant",
    "mqtt",
    "iot",
    "smart-home"
  ],
  "author": "Kimmo Saari <kirbo@kirbo-designs.com>",
  "license": "MIT",
  "imports": {
    "#/*": "./src/*"
  },
  "alpineVersion": "3.24",
  "corepackVersion": "0.36.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "dependencies": {
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
