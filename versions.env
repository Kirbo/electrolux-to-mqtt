# Single source of truth for every toolchain / base-image version in this repo.
#
# Plain KEY=value lines only (no quotes, no spaces, no expansions): the file is
# sourced by sh (`set -a; . ./versions.env; set +a`), loaded by mise ([env] _.file),
# appended to GitLab CI's dotenv report, and passed to Dockerfiles/compose as
# build-args of the SAME names. Nothing has a default anywhere else — a missing
# value fails loudly. `scripts/sync-versions.sh` enforces the format.
#
# Every version is EXACT (X.Y.Z, never a bare major). After editing a mise tool's
# version (node, pnpm, fnox, age, git-cliff), run `mise lock` (mise.lock records each
# one's URL + sha256 per platform); after a Node/Alpine bump, `bash
# scripts/node-images.sh pin` (the image digests below). Then run `pnpm sync:versions`
# (or `mise run sync-versions`): it writes the derived copies into package.json —
# engines.node + @types/node (both packages), packageManager (pnpm, with its integrity
# hash), alpineVersion, corepackVersion, nodeImageDigest, nodeDevImageDigest — and
# re-resolves the lockfiles, then checks (scripts/check-version-sync.mjs) that
# mise.toml + mise.lock, the Dockerfiles and the CI images all agree with this file.
# Those package.json fields exist because package.json is the release-gated CI path:
# a value that changes the shipped image must change package.json, while a dev-tool
# bump here (fnox, age, git-cliff) cuts no release. CI job `versions in sync` fails on
# any drift. Never hand-edit them.
#
# `# renovate:` comments mark each version for Renovate (renovate.json customManagers,
# scheduled CI job `renovate`); keep one directly above the line it describes.

# ── Shipped in the images (derived into package.json → cuts a release) ────────
# Node.js, EXACT version. LTS lines only (even majors). mise installs it, engines.node
# is derived from it, and every Node image is node:<this>-alpine<ALPINE_VERSION>.
# renovate: datasource=node-version depName=node versioning=node
NODE_VERSION=26.13.0
# Index digests (multi-arch) of the three Node images for NODE_VERSION + ALPINE_VERSION:
# every Dockerfile FROM and every CI node job image is pinned `<image>:<tag>@<digest>`.
# Renovate cannot compute them: after a NODE_VERSION / ALPINE_VERSION bump, or to pick up
# a rebuilt base, run `bash scripts/node-images.sh pin` (needs a dhi.io login). CI job
# `docker build test` runs `scripts/node-images.sh check`: each digest must be an image
# of exactly NODE_VERSION.
#   dhi.io/node:<NODE_VERSION>-alpine<ALPINE_VERSION>       prod runtime stage
NODE_DHI_DIGEST=sha256:732b7f53f1a10df0c4e8ded0af55fadb6c0c778c987d2c855755b72a1cc85a86
#   dhi.io/node:<NODE_VERSION>-alpine<ALPINE_VERSION>-dev   prod build stages
NODE_DHI_DEV_DIGEST=sha256:e6cd8d32b43a3a6c1682f34b446e9792c58cf6a3383496c49f0ea80b499fd70f
#   node:<NODE_VERSION>-alpine<ALPINE_VERSION>              local dev, telemetry-backend, CI jobs
NODE_STOCK_DIGEST=sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216
# Alpine of every Node image: dhi.io/node:<NODE_VERSION>-alpine<ver> (prod) and stock
# node:<NODE_VERSION>-alpine<ver> (local dev, telemetry-backend, CI). The tag must exist
# on BOTH registries before bumping.
# renovate: datasource=docker depName=alpine versioning=regex:^(?<major>\d+)\.(?<minor>\d+)$
ALPINE_VERSION=3.24
# Node 25+ bundles no Corepack: images and CI install this version with npm,
# then Corepack activates pnpm from package.json packageManager.
# renovate: datasource=npm depName=corepack
COREPACK_VERSION=0.36.0
# pnpm. packageManager (with sha512) is derived from it by sync-versions.
# renovate: datasource=npm depName=pnpm
PNPM_VERSION=12.18.0

# ── Dev / CI tooling only (no release) ────────────────────────────────────────
# Secrets (fnox.toml). mise installs fnox + age locally; CI jobs that need a secret
# download the release assets below via ci/install-fnox.sh and verify these sha256
# pins (musl/static builds; x86_64 = shared runners, aarch64 = the macOS runner's
# Linux containers). Bump the version and all four hashes together.
# renovate: datasource=github-releases depName=jdx/fnox extractVersion=^v(?<version>.+)$
FNOX_VERSION=1.47.0
FNOX_SHA256_LINUX_X86_64=d371fcc893f4abc660ff8f10b5c6fe36745d81ba6ae094c22c8fe4dbdaf17e4f
FNOX_SHA256_LINUX_AARCH64=310ef903464817770823f9c4d3189c0f9457ec1c57463451059eefd31046de97
# age ≥ 1.3.2: ships age-plugin-pq, through which fnox decrypts the project's
# post-quantum (age1pq1…) keys.
# renovate: datasource=github-releases depName=FiloSottile/age extractVersion=^v(?<version>.+)$
AGE_VERSION=1.3.2
AGE_SHA256_LINUX_X86_64=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
AGE_SHA256_LINUX_AARCH64=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4
# Changelog/release notes (cliff.toml). CI runs orhunp/git-cliff:<this>.
# renovate: datasource=docker depName=orhunp/git-cliff
GIT_CLIFF_VERSION=2.14.2
# Renovate itself (CI job `renovate`, image ghcr.io/renovatebot/renovate:<this>).
# renovate: datasource=docker depName=ghcr.io/renovatebot/renovate
RENOVATE_VERSION=44.172.2
