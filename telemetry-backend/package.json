{
  "name": "electrolux-to-mqtt-telemetry-backend",
  "version": "1.0.0",
  "description": "Aptabase-backed telemetry backend: serves SVG badges (in-memory) + receives legacy /telemetry POSTs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev:docker": "docker compose down ; docker compose up --build",
    "deps:check": "pnpm outdated ; pnpm audit",
    "deps:update": "pnpm update --latest && bash ../scripts/sync-versions.sh && pnpm install"
  },
  "keywords": [],
  "author": "Kimmo Saari <kirbo@kirbo-designs.com>",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
