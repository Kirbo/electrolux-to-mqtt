# Docker files (don't need these inside the image)
docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Local environment — the **/ variants matter: patterns without **/ match only at
# the context root, and telemetry-backend/Dockerfile builds with the repo root as
# context, so a bare `.env` would still COPY telemetry-backend/.env (decrypted
# SOPS secrets) into the builder layer.
.env
.env.*
.envrc
**/.env
**/.env.*
**/config.yml
**/tests
**/dist
**/coverage

# Temporary files
tmp
temp
*.tmp