{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-origin-freshness.sh\"",
            "timeout": 30,
            "statusMessage": "Checking origin freshness (max once per 6h)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-branch-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Checking branch is in sync with origin..."
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "PATH=\"/Users/kimmo.saari/.local/share/fnm/node-versions/v24.14.1/installation/bin:$PATH\" pnpm check",
            "timeout": 60,
            "statusMessage": "Running pnpm check before commit..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "read -r input; fp=$(echo \"$input\" | jq -r '.tool_input.file_path'); root=$(git -C \"$(dirname \"$fp\")\" rev-parse --show-toplevel 2>/dev/null); [[ -n \"$root\" && \"$fp\" == \"$root\"/* ]] && cd \"$root\" && pnpm check 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Running pnpm check..."
          }
        ]
      }
    ]
  }
}
